# The benchmarked repo is cloned by `make setup`, never vendored.
/pytest/

# Per-instance checkouts (~40MB each, regenerated by every run).
/pytest-worktrees/

# Shared venv built by `make setup`.
/.venv/
/.venv-*/

# Run artifacts: local debugging only, never shared.
# state/ is resumable run state, runs/ holds agent patches, logs and verdicts.
harness/state/
harness/runs/
harness/results*.json
harness/results*.md

# Mining scratch
/tmp/prs.jsonl

__pycache__/
*.pyc
.DS_Store
